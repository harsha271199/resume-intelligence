# ─────────────────────────────────────────────
# Resume Intelligence — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# spaCy model name (en_core_web_sm for speed, en_core_web_trf for accuracy)
SPACY_MODEL=en_core_web_sm

# Sentence-Transformers model for semantic similarity
SBERT_MODEL=all-MiniLM-L6-v2

# ── Scoring weights (must sum to 1.0) ──────────
SCORE_W1=0.35   # skill coverage
SCORE_W2=0.35   # semantic similarity
SCORE_W3=0.15   # skill gap penalty
SCORE_W4=0.15   # experience depth

# ── Bias audit threshold ────────────────────────
# Scores >= threshold are treated as positive predictions
AUDIT_THRESHOLD=50

# ── Dataset paths ───────────────────────────────
# Leave blank to fall back to built-in synthetic data
RESUME_DATASET_PATH=
NER_DATASET_PATH=
JD_DATASET_PATH=
